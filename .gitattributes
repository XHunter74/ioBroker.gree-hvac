# Generated by the Vite build (tasks.js). Git must not touch the bytes: the file name
# carries a content hash, so a line-ending rewrite would desynchronise name and content.
admin/assets/** -text
# Vite emits mixed line endings here (injected tags vs. copied source), so let git
# normalise it. Without this the CI guard `git diff --exit-code -- admin/` fails
# whenever the file is built on a different platform than it was committed from.
admin/tab.html text eol=lf
# The tab HTML is copied verbatim by the Vite build, and the build is not byte-stable
# with respect to the source line endings - pin the source to LF so a Windows build
# and the Linux CI build produce the same admin/tab.html.
src-admin/index.html text eol=lf
